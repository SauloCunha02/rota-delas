{
  "hosting": {
    "site": "rotadelas-ceara2026",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "**/*.{js,css,json}", "headers": [{"key": "Cache-Control", "value": "public,max-age=300"}]}
    ]
  }
}
